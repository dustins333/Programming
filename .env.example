EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ADMIN_EMAIL=

# Web Push (VAPID) public key — safe to expose client-side. The matching
# private key lives only as a Supabase Edge Function secret (VAPID_PRIVATE_KEY),
# never in this file. Generate a pair with `npx web-push generate-vapid-keys`.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
