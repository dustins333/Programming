{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/blocks/:blockId", "destination": "/blocks/[blockId]" },
    { "source": "/builder/:workoutId", "destination": "/builder/[workoutId]" },
    { "source": "/clients/:userId", "destination": "/clients/[userId]" },
    { "source": "/events/:eventId/responses", "destination": "/events/[eventId]/responses" },
    { "source": "/events/:eventId", "destination": "/events/[eventId]" },
    { "source": "/history/:exerciseId", "destination": "/history/[exerciseId]" },
    { "source": "/nutrition/clients/:userId", "destination": "/nutrition/clients/[userId]" },
    {
      "source": "/nutrition/clients/:userId/onboarding/:step",
      "destination": "/nutrition/clients/[userId]/onboarding/:step"
    },
    { "source": "/spc/blocks/:blockId", "destination": "/spc/blocks/[blockId]" },
    { "source": "/spc/builder/:workoutId", "destination": "/spc/builder/[workoutId]" },
    { "source": "/spc/history/:userId", "destination": "/spc/history/[userId]" },
    { "source": "/spc/print/:blockId", "destination": "/spc/print/[blockId]" },
    { "source": "/spc/overview/:userId", "destination": "/spc/overview/[userId]" },
    { "source": "/spc/templates/:templateId", "destination": "/spc/templates/[templateId]" },
    { "source": "/spc/:userId", "destination": "/spc/[userId]" }
  ]
}
