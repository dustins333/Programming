{
  "expo": {
    "name": "Kova Strength",
    "slug": "kova-strength",
    "scheme": "kovastrength",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kovastrength.mobile",
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kovastrength.app",
      "adaptiveIcon": {
        "backgroundColor": "#a46a57",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#a46a57"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kova Strength needs access to your photos to upload progress photos.",
          "cameraPermission": "Kova Strength needs access to your camera to take progress photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f6a5da8-3f8c-4b8e-ab41-82dc26336219"
      }
    },
    "owner": "kova-strength"
  }
}
